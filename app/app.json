{
  "expo": {
    "name": "Ubber",
    "slug": "ubber",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#111111"
    },
    "extra": {
      "serverUrl": "https://ubber-backend.onrender.com"
    },
    "ios": {
      "bundleIdentifier": "com.ubber.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Ubber uses your location to match rides."
      }
    },
    "android": {
      "package": "com.ubber.app",
      "versionCode": 1,
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    }
  }
}
